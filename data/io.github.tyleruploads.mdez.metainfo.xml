<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>io.github.tyleruploads.mdez</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>MIT</project_license>
    <name>MDEZ++</name>
    <summary>Lightweight Markdown Editor</summary>
    <description>
        <p>
MDEZ++ (mdez) is an open-source, lightweight, cross-platform C++20 and Qt GUI Markdown editor. Instead of a WYSIWYG editor, MDEZ++ renders a real-time live preview of your text in a split-screen pane using a fast, native, and minimal GUI. MDEZ++ can also edit any text-based file format, including HTML, plain text, and code files, making it highly versatile.</p>
    </description>
    <developer id="io.github.tyleruploads">
        <name>Tyleruploads</name>
    </developer>
    <branding>
        <color type="primary" scheme_preference="light">#f66151</color>
        <color type="primary" scheme_preference="dark">#613583</color>
    </branding>
    <requires>
        <control>keyboard</control>
        <control>pointing</control>
    </requires>
    <url type="vcs-browser">https://github.com/tyleruploads/mdez</url>
    <url type="homepage">https://github.com/tyleruploads/mdez</url>
    <url type="contribute">https://github.com/tyleruploads/mdez</url>
    <url type="bugtracker">https://github.com/tyleruploads/mdez/issues</url>
    <url type="contact">https://tyler.is-a.dev/contact</url>
    <content_rating type="oars-1.1" />
